# CSE ASPIRANT ENVIRONMENT TEMPLATE
# Status labels: IMPLEMENTED = read by current source; MISSING = feature exists but
# has no env-backed setting; PLANNED = future integration only and ignored by code.
# Never commit a populated .env file. Replace every placeholder before deployment.

# -----------------------------------------------------------------------------
# Telegram Bot [IMPLEMENTED]
# -----------------------------------------------------------------------------
# Required. Obtain from @BotFather. Example only; never use this value.
BOT_TOKEN=replace-with-botfather-token
# Required. Obtain from https://my.telegram.org under API development tools.
TELEGRAM_API_ID=12345678
# Required. Obtain with TELEGRAM_API_ID from my.telegram.org.
TELEGRAM_API_HASH=replace-with-telegram-api-hash

# -----------------------------------------------------------------------------
# Telegram Assistant Session [IMPLEMENTED]
# -----------------------------------------------------------------------------
# Required for voice-chat playback. Generate a Hydrogram user session string
# using your own Telegram account; never place a real session string here.
TELEGRAM_SESSION_STRING=replace-with-hydrogram-user-session-string
# PLANNED: session name is currently hard-coded in bot/client.py and is ignored.
# TELEGRAM_ASSISTANT_SESSION_NAME=cse_aspirant_assistant

# -----------------------------------------------------------------------------
# Owner and Sudo [IMPLEMENTED]
# -----------------------------------------------------------------------------
# Required. Numeric Telegram user ID of the owner.
OWNER_ID=123456789
# Optional. Comma-separated numeric Telegram user IDs.
SUDO_USERS=123456789,987654321
# Optional. Welcome/start image URL; source default is used when omitted.
START_IMG_URL=https://example.com/start-image.jpg

# -----------------------------------------------------------------------------
# Music Streaming and PyTgCalls [IMPLEMENTED/MISSING]
# -----------------------------------------------------------------------------
# Hydrogram and PyTgCalls use the Telegram values above. No separate credential
# is read by the current source.
# MISSING: these controls are currently hard-coded or code-only.
# MUSIC_DEFAULT_VOLUME=100
# MUSIC_MAX_VOLUME=200
# MUSIC_QUEUE_MAX_SIZE=1024
# PYTGCALLS_CACHE_DIR=/var/cache/cse-aspirant

# -----------------------------------------------------------------------------
# Go Audio Engine and Stream Authentication [IMPLEMENTED]
# -----------------------------------------------------------------------------
# Required. Python bridge URL for the Go engine.
GO_ENGINE_URL=http://localhost:8080
# Required. Same bearer token must be used by Python and Go.
GO_ENGINE_TOKEN=replace-with-at-least-32-character-shared-engine-secret
# Optional. Go engine listen port; source default is 8080.
GO_ENGINE_PORT=8080
# Optional. Public URL used in generated audio stream URLs.
GO_ENGINE_PUBLIC_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# FFmpeg and Audio [IMPLEMENTED/MISSING]
# -----------------------------------------------------------------------------
# IMPLEMENTED: Go executes this binary through exec.CommandContext. Docker
# installs ffmpeg and startup verifies this executable is accessible.
FFMPEG_PATH=ffmpeg
# The following tuning controls are planned and ignored by current source:
# AUDIO_OUTPUT_FORMAT=opus
# AUDIO_BITRATE_KBPS=128
# AUDIO_SAMPLE_RATE=48000

# -----------------------------------------------------------------------------
# Playback, Multi-Group and Recovery [MISSING]
# -----------------------------------------------------------------------------
# Playback state, queues and recovery exist in source but are not env-backed.
# These commented values are documentation for a future configuration change.
# PLAYBACK_MAX_GROUPS=100
# PLAYBACK_STREAM_TTL_SECONDS=3600
# PLAYBACK_RETRY_COUNT=2
# PLAYBACK_RETRY_BACKOFF_SECONDS=0.3
# PLAYBACK_WORKER_COUNT=8

# -----------------------------------------------------------------------------
# YouTube and Other Media Sources [PLANNED]
# -----------------------------------------------------------------------------
# No media-source credentials or proxy variables are read by current source.
# YOUTUBE_API_KEY=obtain-from-google-cloud-console
# YOUTUBE_COOKIES_FILE=/run/secrets/youtube-cookies.txt
# MEDIA_PROXY_URL=http://user:password@proxy.example.com:8080
# MEDIA_ALLOWED_HOSTS=youtube.com,youtu.be

# -----------------------------------------------------------------------------
# PostgreSQL Database [IMPLEMENTED]
# -----------------------------------------------------------------------------
# Required. Obtain from the PostgreSQL administrator or managed database URL.
DATABASE_URL=postgresql://cse_admin:replace-with-db-password@localhost:5432/cse_aspirant
# Compose-only values for the local PostgreSQL container. Use the same values
# in DATABASE_URL when running the bundled database service.
POSTGRES_USER=cse_admin
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=cse_aspirant
# MISSING: pool values are currently hard-coded in database/connection.py.
# DATABASE_POOL_MIN_SIZE=1
# DATABASE_POOL_MAX_SIZE=10

# -----------------------------------------------------------------------------
# Redis [IMPLEMENTED]
# -----------------------------------------------------------------------------
# Required. Obtain from the Redis administrator or managed Redis service.
REDIS_URL=redis://localhost:6379/0
# MISSING: timeout and cache policy are currently hard-coded.
# REDIS_SOCKET_TIMEOUT_SECONDS=2
# REDIS_DEFAULT_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# FastAPI [IMPLEMENTED]
# -----------------------------------------------------------------------------
# Optional host; source default is 0.0.0.0.
API_HOST=0.0.0.0
# Optional API port; source default is 8000.
API_PORT=8000

# -----------------------------------------------------------------------------
# Website and CORS [IMPLEMENTED/MISSING]
# -----------------------------------------------------------------------------
# Optional comma-separated browser origins. Obtain production origins from the
# website deployment. Local dashboard uses http://localhost:3000.
CORS_ORIGINS=http://localhost:3000
# IMPLEMENTED in ui/src/api.ts as Vite build-time variables. These values are
# embedded in browser JavaScript; never put MASTER_API_KEY or another secret in
# them. Use a scoped/revocable API key, or leave VITE_API_KEY empty.
# Copy these two lines to ui/.env.local for a Vite build.
# VITE_API_BASE_URL=http://localhost:8000
# VITE_API_KEY=replace-with-scoped-revocable-dashboard-api-key
# PLANNED: no analytics or frontend secret integration exists.
# FRONTEND_ANALYTICS_ID=obtain-from-analytics-provider

# -----------------------------------------------------------------------------
# JWT, API Keys and Security [IMPLEMENTED/MISSING]
# -----------------------------------------------------------------------------
# IMPLEMENTED: dedicated master X-API-Key bypass secret. Generate locally with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
MASTER_API_KEY=replace-with-64-character-random-master-api-key
# READ BUT UNUSED: loaded by Python configuration, but no JWT signing or
# verification code currently exists. Do not use this as an API key.
JWT_SECRET=not-used-until-jwt-is-implemented
# PLANNED: no JWT library, expiry, refresh, OAuth, or webhook signing exists.
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# API_KEY_HEADER=X-API-Key
# WEBHOOK_SIGNING_SECRET=obtain-from-provider

# -----------------------------------------------------------------------------
# AI Providers [IMPLEMENTED/PLANNED]
# -----------------------------------------------------------------------------
# Optional. Current engine defaults to local heuristic behavior.
AI_PROVIDER=local
# READ BUT UNUSED: loaded by configuration, but no external provider call exists.
AI_API_KEY=obtain-from-selected-provider
# PLANNED and ignored until provider integrations are implemented:
# AI_MODEL=provider-model-name
# AI_BASE_URL=https://api.provider.example/v1
# OPENAI_API_KEY=obtain-from-platform.openai.com
# GEMINI_API_KEY=obtain-from-Google AI Studio
# ANTHROPIC_API_KEY=obtain-from-console.anthropic.com
# GROQ_API_KEY=obtain-from-console.groq.com
# OLLAMA_BASE_URL=http://localhost:11434
# AI_REQUEST_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Education, UPSC and Programming [PLANNED]
# -----------------------------------------------------------------------------
# Modules currently use bundled source content and read no environment values.
# EDUCATION_CONTENT_DIR=/app/education-content
# UPSC_CONTENT_SOURCE_URL=obtain-from-your-content-service
# PROGRAMMING_CONTENT_SOURCE_URL=obtain-from-your-content-service
# EDUCATION_FEATURE_FLAGS=upsc,cs,programming

# -----------------------------------------------------------------------------
# Premium and Pro Subscriptions [IMPLEMENTED/MISSING]
# -----------------------------------------------------------------------------
# Tier and quota logic are implemented, but thresholds are code-defined.
# PREMIUM_PRICE_INR=199
# PRO_PRICE_INR=499
# PREMIUM_RATE_LIMIT_PER_MINUTE=60
# PRO_RATE_LIMIT_PER_MINUTE=999999
# SUBSCRIPTION_DEFAULT_DAYS=30

# -----------------------------------------------------------------------------
# Payment Gateway and Verification [IMPLEMENTED/MISSING/PLANNED]
# -----------------------------------------------------------------------------
# Required for the current manual UPI/NEFT/card invoice generator. Obtain from
# your merchant/bank; placeholders below are not valid payment credentials.
PAYMENT_UPI_ID=merchant@example
PAYMENT_MERCHANT_NAME=Replace With Registered Merchant Name
PAYMENT_BANK_NAME=Replace With Bank Name
PAYMENT_ACCOUNT_NAME=Replace With Registered Account Name
PAYMENT_ACCOUNT_NUMBER=replace-with-bank-account-number
PAYMENT_IFSC_CODE=replace-with-ifsc-code
PAYMENT_BANK_BRANCH=Replace With Bank Branch
PAYMENT_CHECKOUT_URL=https://payments.example.com
# PLANNED and ignored: no automated payment SDK or webhook exists.
# RAZORPAY_KEY_ID=obtain-from-Razorpay-dashboard
# RAZORPAY_KEY_SECRET=obtain-from-Razorpay-dashboard
# STRIPE_SECRET_KEY=obtain-from-Stripe-dashboard
# STRIPE_WEBHOOK_SECRET=obtain-from-Stripe-dashboard
# PAYU_MERCHANT_KEY=obtain-from-PayU
# PAYU_SALT=obtain-from-PayU
# PAYMENT_WEBHOOK_URL=https://api.example.com/webhooks/payment

# -----------------------------------------------------------------------------
# Owner, Sudo, Moderation, Welcome and Group Management [IMPLEMENTED/MISSING]
# -----------------------------------------------------------------------------
# OWNER_ID and SUDO_USERS above are the only current environment controls.
# MISSING/PLANNED: source modules have no env-backed admin/group thresholds.
# ADMIN_GROUP_IDS=-1001234567890
# ALLOWED_GROUP_IDS=-1001234567890
# WELCOME_ENABLED=true
# WELCOME_MESSAGE=Welcome to CSE Aspirant
# MODERATION_ENABLED=true
# MODERATION_MAX_WARNINGS=3

# -----------------------------------------------------------------------------
# Broadcast and Rate Limits [MISSING/PLANNED]
# -----------------------------------------------------------------------------
# Broadcast and anti-flood modules currently use code-defined behavior.
# BROADCAST_ENABLED=false
# BROADCAST_BATCH_SIZE=20
# BROADCAST_DELAY_SECONDS=1
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_MAX_REQUESTS=60
# ANTI_FLOOD_MAX_MESSAGES=10

# -----------------------------------------------------------------------------
# Logging, Monitoring and Error Handling [MISSING/PLANNED]
# -----------------------------------------------------------------------------
# Logging, metrics, retries and circuit breakers currently have code defaults.
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# METRICS_ENABLED=true
# METRICS_HOST=0.0.0.0
# METRICS_PORT=9090
# SENTRY_DSN=obtain-from-Sentry-project
# RETRY_MAX_ATTEMPTS=3
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

